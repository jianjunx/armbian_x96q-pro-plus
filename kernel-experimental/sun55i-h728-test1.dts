/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "X96Q Pro+";
	compatible = "amediatech,x96q-pro-plus\0allwinner,sun55i-h728";

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x06>;
				};

				core1 {
					cpu = <0x07>;
				};

				core2 {
					cpu = <0x08>;
				};

				core3 {
					cpu = <0x09>;
				};
			};
		};

		cpu@0 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x00>;
			enable-method = "psci";
			clocks = <0x0a 0x00>;
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x400>;
			operating-points-v2 = <0x0b>;
			cpu-supply = <0x0c>;
			phandle = <0x02>;
		};

		cpu@100 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x100>;
			enable-method = "psci";
			clocks = <0x0a 0x00>;
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x400>;
			operating-points-v2 = <0x0b>;
			phandle = <0x03>;
		};

		cpu@200 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x200>;
			enable-method = "psci";
			clocks = <0x0a 0x00>;
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x400>;
			operating-points-v2 = <0x0b>;
			phandle = <0x04>;
		};

		cpu@300 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x300>;
			enable-method = "psci";
			clocks = <0x0a 0x00>;
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x400>;
			operating-points-v2 = <0x0b>;
			phandle = <0x05>;
		};

		cpu@400 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x400>;
			enable-method = "psci";
			clocks = <0x0a 0x01>;
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x400>;
			operating-points-v2 = <0x0d>;
			cpu-supply = <0x0e>;
			phandle = <0x06>;
		};

		cpu@500 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x500>;
			enable-method = "psci";
			clocks = <0x0a 0x01>;
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x400>;
			operating-points-v2 = <0x0d>;
			phandle = <0x07>;
		};

		cpu@600 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x600>;
			enable-method = "psci";
			clocks = <0x0a 0x01>;
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x400>;
			operating-points-v2 = <0x0d>;
			phandle = <0x08>;
		};

		cpu@700 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x700>;
			enable-method = "psci";
			clocks = <0x0a 0x01>;
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x400>;
			operating-points-v2 = <0x0d>;
			phandle = <0x09>;
		};
	};

	osc24M-clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "osc24M";
		phandle = <0x13>;
	};

	pmu {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <0x01 0x07 0x04>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		arm,no-tick-in-suspend;
		interrupts = <0x01 0x0d 0x04 0x01 0x0e 0x04 0x01 0x0b 0x04 0x01 0x0a 0x04 0x01 0x0c 0x04>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0x40000000>;
		phandle = <0x48>;

		gpu@1800000 {
			compatible = "allwinner,sun55i-a523-mali\0arm,mali-valhall-jm";
			reg = <0x1800000 0x10000>;
			interrupts = <0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x77 0x04>;
			interrupt-names = "job\0mmu\0gpu";
			clocks = <0x0f 0x33 0x0f 0x34>;
			clock-names = "core\0bus";
			power-domains = <0x10 0x01>;
			resets = <0x0f 0x06>;
			operating-points-v2 = <0x11>;
			status = "okay";
			mali-supply = <0x12>;
			phandle = <0x49>;
		};

		pinctrl@2000000 {
			compatible = "allwinner,sun55i-a523-pinctrl";
			reg = <0x2000000 0x800>;
			interrupts = <0x00 0x43 0x04 0x00 0x45 0x04 0x00 0x47 0x04 0x00 0x49 0x04 0x00 0x4b 0x04 0x00 0x4d 0x04 0x00 0x4f 0x04 0x00 0x51 0x04 0x00 0x53 0x04 0x00 0x55 0x04 0x00 0x8c 0x04>;
			clocks = <0x0f 0x2b 0x13 0x14 0x00>;
			clock-names = "apb\0hosc\0losc";
			gpio-controller;
			#gpio-cells = <0x03>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			vcc-pb-supply = <0x15>;
			vcc-pc-supply = <0x16>;
			vcc-pd-supply = <0x17>;
			vcc-pe-supply = <0x17>;
			vcc-pf-supply = <0x15>;
			vcc-pg-supply = <0x18>;
			vcc-ph-supply = <0x15>;
			vcc-pi-supply = <0x17>;
			vcc-pj-supply = <0x17>;
			vcc-pk-supply = <0x19>;
			phandle = <0x20>;

			i2s2-pi-pins {
				pins = "PI2\0PI3\0PI4\0PI5";
				allwinner,pinmux = <0x05>;
				function = "i2s2";
				bias-disable;
				phandle = <0x4a>;
			};

			ledc-ph-pin {
				pins = "PH19";
				function = "ledc";
				allwinner,pinmux = <0x05>;
				phandle = <0x4b>;
			};

			mmc0-pins {
				pins = "PF0\0PF1\0PF2\0PF3\0PF4\0PF5";
				allwinner,pinmux = <0x02>;
				function = "mmc0";
				drive-strength = <0x28>;
				bias-pull-up;
				phandle = <0x1e>;
			};

			mmc1-pins {
				pins = "PG0\0PG1\0PG2\0PG3\0PG4\0PG5";
				allwinner,pinmux = <0x02>;
				function = "mmc1";
				drive-strength = <0x14>;
				bias-pull-up;
				phandle = <0x21>;
			};

			mmc2-pins {
				pins = "PC0\0PC1\0PC5\0PC6\0PC8\0PC9\0PC10\0PC11\0PC13\0PC14\0PC15\0PC16";
				allwinner,pinmux = <0x03>;
				function = "mmc2";
				drive-strength = <0x28>;
				bias-pull-up;
				phandle = <0x23>;
			};

			rgmii0-pins {
				pins = "PH0\0PH1\0PH2\0PH3\0PH4\0PH5\0PH6\0PH7\0PH9\0PH10\0PH14\0PH15\0PH16\0PH17\0PH18";
				allwinner,pinmux = <0x05>;
				function = "gmac0";
				drive-strength = <0x28>;
				bias-disable;
				phandle = <0x25>;
			};

			rgmii0-25m-pin {
				pins = "PH13";
				allwinner,pinmux = <0x05>;
				function = "gmac0";
				drive-strength = <0x28>;
				bias-disable;
				phandle = <0x4c>;
			};

			rgmii1-pins {
				pins = "PJ0\0PJ1\0PJ2\0PJ3\0PJ4\0PJ5\0PJ6\0PJ7\0PJ8\0PJ9\0PJ11\0PJ12\0PJ13\0PJ14\0PJ15";
				allwinner,pinmux = <0x05>;
				function = "gmac1";
				drive-strength = <0x28>;
				bias-disable;
				phandle = <0x27>;
			};

			spdif-pb-pin {
				pins = "PB8";
				function = "spdif";
				allwinner,pinmux = <0x02>;
				phandle = <0x4d>;
			};

			spdif-pi-pin {
				pins = "PI10";
				function = "spdif";
				allwinner,pinmux = <0x02>;
				phandle = <0x4e>;
			};

			spi0-pc-pins {
				pins = "PC2\0PC4\0PC12";
				function = "spi0";
				allwinner,pinmux = <0x04>;
				phandle = <0x4f>;
			};

			spi0-pj-pins {
				pins = "PJ21\0PJ22\0PJ23";
				function = "spi0";
				allwinner,pinmux = <0x05>;
				phandle = <0x50>;
			};

			spi0-cs0-pc-pin {
				pins = "PC3";
				function = "spi0";
				allwinner,pinmux = <0x04>;
				phandle = <0x51>;
			};

			spi0-cs0-pj-pin {
				pins = "PJ20";
				function = "spi0";
				allwinner,pinmux = <0x05>;
				phandle = <0x52>;
			};

			spi0-cs1-pc-pin {
				pins = "PC7";
				function = "spi0";
				allwinner,pinmux = <0x04>;
				phandle = <0x53>;
			};

			spi0-cs1-pj-pin {
				pins = "PJ24";
				function = "spi0";
				allwinner,pinmux = <0x05>;
				phandle = <0x54>;
			};

			spi0-hold-pc-pin {
				pins = "PC16";
				function = "spi0";
				allwinner,pinmux = <0x04>;
				phandle = <0x55>;
			};

			spi0-hold-pj-pin {
				pins = "PJ26";
				function = "spi0";
				allwinner,pinmux = <0x05>;
				phandle = <0x56>;
			};

			spi0-wp-pc-pin {
				pins = "PC15";
				function = "spi0";
				allwinner,pinmux = <0x04>;
				phandle = <0x57>;
			};

			spi0-wp-pj-pin {
				pins = "PJ25";
				function = "spi0";
				allwinner,pinmux = <0x05>;
				phandle = <0x58>;
			};

			rgmii1-25m-pin {
				pins = "PJ10";
				allwinner,pinmux = <0x05>;
				function = "gmac1";
				drive-strength = <0x28>;
				bias-disable;
				phandle = <0x28>;
			};

			uart0-pb-pins {
				pins = "PB9\0PB10";
				allwinner,pinmux = <0x02>;
				function = "uart0";
				phandle = <0x1b>;
			};

			uart1-pins {
				pins = "PG6\0PG7";
				function = "uart1";
				allwinner,pinmux = <0x02>;
				phandle = <0x59>;
			};

			uart1-rts-cts-pins {
				pins = "PG8\0PG9";
				function = "uart1";
				allwinner,pinmux = <0x02>;
				phandle = <0x5a>;
			};
		};

		clock-controller@2001000 {
			compatible = "allwinner,sun55i-a523-ccu";
			reg = <0x2001000 0x1000>;
			clocks = <0x13 0x14 0x00 0x14 0x02 0x14 0x01>;
			clock-names = "hosc\0losc\0iosc\0losc-fanout";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x0f>;
		};

		led-controller@2008000 {
			compatible = "allwinner,sun55i-a523-ledc\0allwinner,sun50i-a100-ledc";
			reg = <0x2008000 0x400>;
			interrupts = <0x00 0x1c 0x04>;
			clocks = <0x0f 0xa1 0x0f 0xa0>;
			clock-names = "bus\0mod";
			resets = <0x0f 0x4b>;
			dmas = <0x1a 0x2a>;
			dma-names = "tx";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
			phandle = <0x5b>;
		};

		adc@2009000 {
			compatible = "allwinner,sun55i-a523-gpadc";
			reg = <0x2009000 0x400>;
			clocks = <0x0f 0x7c 0x0f 0x7a>;
			clock-names = "bus\0mod";
			resets = <0x0f 0x2e>;
			interrupts = <0x00 0x3d 0x04>;
			#io-channel-cells = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
			phandle = <0x5c>;
		};

		watchdog@2050000 {
			compatible = "allwinner,sun55i-a523-wdt";
			reg = <0x2050000 0x20>;
			interrupts = <0x00 0x3f 0x04>;
			clocks = <0x13 0x14 0x00>;
			clock-names = "hosc\0losc";
			status = "okay";
			phandle = <0x5d>;
		};

		serial@2500000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x2500000 0x400>;
			interrupts = <0x00 0x02 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x0f 0x5b>;
			resets = <0x0f 0x17>;
			dmas = <0x1a 0x0e 0x1a 0x0e>;
			dma-names = "tx\0rx";
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x1b>;
			phandle = <0x5e>;
		};

		serial@2500400 {
			compatible = "snps,dw-apb-uart";
			reg = <0x2500400 0x400>;
			interrupts = <0x00 0x03 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x0f 0x5c>;
			resets = <0x0f 0x18>;
			dmas = <0x1a 0x0f 0x1a 0x0f>;
			dma-names = "tx\0rx";
			status = "disabled";
			phandle = <0x5f>;
		};

		serial@2500800 {
			compatible = "snps,dw-apb-uart";
			reg = <0x2500800 0x400>;
			interrupts = <0x00 0x04 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x0f 0x5d>;
			resets = <0x0f 0x19>;
			dmas = <0x1a 0x10 0x1a 0x10>;
			dma-names = "tx\0rx";
			status = "disabled";
			phandle = <0x60>;
		};

		serial@2500c00 {
			compatible = "snps,dw-apb-uart";
			reg = <0x2500c00 0x400>;
			interrupts = <0x00 0x05 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x0f 0x5e>;
			resets = <0x0f 0x1a>;
			dmas = <0x1a 0x11 0x1a 0x11>;
			dma-names = "tx\0rx";
			status = "disabled";
			phandle = <0x61>;
		};

		serial@2501000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x2501000 0x400>;
			interrupts = <0x00 0x06 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x0f 0x5f>;
			resets = <0x0f 0x1b>;
			dmas = <0x1a 0x12 0x1a 0x12>;
			dma-names = "tx\0rx";
			status = "disabled";
			phandle = <0x62>;
		};

		serial@2501400 {
			compatible = "snps,dw-apb-uart";
			reg = <0x2501400 0x400>;
			interrupts = <0x00 0x07 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x0f 0x60>;
			resets = <0x0f 0x1c>;
			dmas = <0x1a 0x13 0x1a 0x13>;
			dma-names = "tx\0rx";
			status = "disabled";
			phandle = <0x63>;
		};

		serial@2501800 {
			compatible = "snps,dw-apb-uart";
			reg = <0x2501800 0x400>;
			interrupts = <0x00 0x08 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x0f 0x61>;
			resets = <0x0f 0x1d>;
			dmas = <0x1a 0x14 0x1a 0x14>;
			dma-names = "tx\0rx";
			status = "disabled";
			phandle = <0x64>;
		};

		serial@2501c00 {
			compatible = "snps,dw-apb-uart";
			reg = <0x2501c00 0x400>;
			interrupts = <0x00 0x09 0x04>;
			reg-shift = <0x02>;
			reg-io-width = <0x04>;
			clocks = <0x0f 0x62>;
			resets = <0x0f 0x1e>;
			dmas = <0x1a 0x15 0x1a 0x15>;
			dma-names = "tx\0rx";
			status = "disabled";
			phandle = <0x65>;
		};

		i2c@2502000 {
			compatible = "allwinner,sun55i-a523-i2c\0allwinner,sun8i-v536-i2c\0allwinner,sun6i-a31-i2c";
			reg = <0x2502000 0x400>;
			interrupts = <0x00 0x0a 0x04>;
			clocks = <0x0f 0x63>;
			resets = <0x0f 0x1f>;
			dmas = <0x1a 0x2b 0x1a 0x2b>;
			dma-names = "rx\0tx";
			status = "disabled";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x66>;
		};

		i2c@2502400 {
			compatible = "allwinner,sun55i-a523-i2c\0allwinner,sun8i-v536-i2c\0allwinner,sun6i-a31-i2c";
			reg = <0x2502400 0x400>;
			interrupts = <0x00 0x0b 0x04>;
			clocks = <0x0f 0x64>;
			resets = <0x0f 0x20>;
			dmas = <0x1a 0x2c 0x1a 0x2c>;
			dma-names = "rx\0tx";
			status = "disabled";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x67>;
		};

		i2c@2502800 {
			compatible = "allwinner,sun55i-a523-i2c\0allwinner,sun8i-v536-i2c\0allwinner,sun6i-a31-i2c";
			reg = <0x2502800 0x400>;
			interrupts = <0x00 0x0c 0x04>;
			clocks = <0x0f 0x65>;
			resets = <0x0f 0x21>;
			dmas = <0x1a 0x2d 0x1a 0x2d>;
			dma-names = "rx\0tx";
			status = "disabled";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x68>;
		};

		i2c@2502c00 {
			compatible = "allwinner,sun55i-a523-i2c\0allwinner,sun8i-v536-i2c\0allwinner,sun6i-a31-i2c";
			reg = <0x2502c00 0x400>;
			interrupts = <0x00 0x0d 0x04>;
			clocks = <0x0f 0x66>;
			resets = <0x0f 0x22>;
			dmas = <0x1a 0x2e 0x1a 0x2e>;
			dma-names = "rx\0tx";
			status = "disabled";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x69>;
		};

		i2c@2503000 {
			compatible = "allwinner,sun55i-a523-i2c\0allwinner,sun8i-v536-i2c\0allwinner,sun6i-a31-i2c";
			reg = <0x2503000 0x400>;
			interrupts = <0x00 0x0e 0x04>;
			clocks = <0x0f 0x67>;
			resets = <0x0f 0x23>;
			dmas = <0x1a 0x2f 0x1a 0x2f>;
			dma-names = "rx\0tx";
			status = "disabled";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x6a>;
		};

		i2c@2503400 {
			compatible = "allwinner,sun55i-a523-i2c\0allwinner,sun8i-v536-i2c\0allwinner,sun6i-a31-i2c";
			reg = <0x2503400 0x400>;
			interrupts = <0x00 0x0f 0x04>;
			clocks = <0x0f 0x68>;
			resets = <0x0f 0x24>;
			dmas = <0x1a 0x30 0x1a 0x30>;
			dma-names = "rx\0tx";
			status = "disabled";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x6b>;
		};

		syscon@3000000 {
			compatible = "allwinner,sun55i-a523-system-control\0allwinner,sun50i-a64-system-control";
