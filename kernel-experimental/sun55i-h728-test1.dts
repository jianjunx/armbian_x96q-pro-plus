			clock-latency-ns = <0x3b9b0>;
		};

		opp-1680000000 {
			opp-hz = <0x00 0x6422c400>;
			opp-microvolt = <0x10c8e0>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp-1800000000 {
			opp-hz = <0x00 0x6b49d200>;
			opp-microvolt = <0x118c30>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp-1992000000 {
			opp-hz = <0x00 0x76bb8200>;
			opp-microvolt = <0x129da0>;
			clock-latency-ns = <0x3b9b0>;
		};
	};

	display-engine {
		compatible = "allwinner,display-engine";
		allwinner,pipelines = <0x46>;
		status = "okay";
	};

	aliases {
		ethernet0 = "/soc/ethernet@4510000";
		serial0 = "/soc/serial@2500000";
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	ext-osc32k-clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x8000>;
		clock-output-names = "ext_osc32k";
		phandle = <0xab>;
	};

	vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-always-on;
		phandle = <0x32>;
	};

	vmid {
		compatible = "regulator-fixed";
		regulator-name = "vmid";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		vin-supply = <0x32>;
		phandle = <0xac>;
	};

	vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x32>;
		regulator-always-on;
		phandle = <0x1f>;
	};

	pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <0x47 0x01 0x01 0x01>;
		post-power-on-delay-ms = <0xc8>;
		phandle = <0x22>;
	};

