--- a/drivers/mmc/sunxi_mmc.c
+++ b/drivers/mmc/sunxi_mmc.c
@@ -557,6 +557,30 @@
 	cfg->f_min = 400000;
 	cfg->f_max = 52000000;
 
+	/* H728 / A523: the SPL build has no device tree and no driver
+	 * model, so the hard-coded values above are all it will ever see.
+	 * The sunxi driver lacks A523 new-timing calibration, and 8-bit at
+	 * 52 MHz is the one eMMC mode that fails on this board: SPL dies
+	 * with "mmc block read error". Force what U-Boot proper only
+	 * reaches through its fallback ladder: 1-bit at 26 MHz.
+	 *
+	 * b_max is capped here too, and only here: this is the legacy
+	 * branch, which is what the SPL compiles without SPL_DM, while
+	 * U-Boot proper takes the DM branch below and keeps reading the
+	 * kernel in large transfers. Instrumented runs showed single-block
+	 * reads succeeding and a 1490-block CMD18 stalling until it timed
+	 * out, so the SPL reads one block per request and never enters the
+	 * failing path at all. Capping the global
+	 * CONFIG_SYS_MMC_MAX_BLK_COUNT instead would make each failed
+	 * chunk pay the ~3 s timeout, 24 times over.
+	 */
+	if (IS_ENABLED(CONFIG_MACH_SUN55I_A523) && sdc_no == 2) {
+		cfg->host_caps &= ~(MMC_MODE_8BIT | MMC_MODE_4BIT |
+				    MMC_MODE_HS_52MHz);
+		cfg->f_max = 26000000;
+		cfg->b_max = 1;
+	}
+
 	if (mmc_resource_init(sdc_no) != 0)
 		return NULL;
 
--- a/drivers/mmc/mmc.c
+++ b/drivers/mmc/mmc.c
@@ -551,8 +551,23 @@
 	do {
 		cur = (blocks_todo > b_max) ? b_max : blocks_todo;
 		if (mmc_read_blocks(mmc, dst, start, cur) != cur) {
+			lbaint_t i;
+
 			pr_debug("%s: Failed to read blocks\n", __func__);
-			return 0;
+			/*
+			 * H728 / A523: the sunxi host has no new-timing calibration,
+			 * so a multi-block transfer to the eMMC can stall without ever
+			 * raising command-done. That is how the SPL died with "mmc
+			 * block read error" before reaching U-Boot proper. Single-block
+			 * reads on the same device were proven to succeed, so retry
+			 * block by block instead of failing the whole load.
+			 */
+			for (i = 0; i < cur; i++) {
+				if (mmc_read_blocks(mmc, (char *)dst +
+						    i * mmc->read_bl_len,
+						    start + i, 1) != 1)
+					return 0;
+			}
 		}
 		blocks_todo -= cur;
 		start += cur;
